#!/usr/bin/env python3
"""omarchy-global-menu-bridge — focused-app menus for the omarchy bar.

Tracks the focused Hyprland window and publishes a JSON snapshot of its menu
to ~/.local/state/omarchy/global-menu/active.json, where the
primo.global-menu bar widget FileView-watches it.

The menu is extracted from the app itself, in this order: org.gtk.Menus
(GTK3), com.canonical.dbusmenu (KDE/Electron), the accessibility tree
(AT-SPI: Qt, GTK4, Electron). Apps that expose none of those get the
*desktop fallback* menu: the focused app's .desktop-file Actions plus
standard window operations.

The AT-SPI stage only works while apps keep their accessibility bridge
enabled, which at-spi2-core >= 2.62 requires a registered AT-SPI event
listener — see enable_atspi() below.

Menu item ids in the snapshot are looked up again at trigger time: the widget
writes {"id": "..."} to request.json and this process executes the stored
action (hyprctl dispatch or a launched command) back in the app.
"""

import argparse
import base64
import configparser
import hashlib
import json
import os
import select
import shlex
import socket
import subprocess
import sys
import time
from pathlib import Path

STATE_DIR = Path(
    os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state")
) / "omarchy" / "global-menu"
ACTIVE_FILE = STATE_DIR / "active.json"
REQUEST_FILE = STATE_DIR / "request.json"
MENU_CONFIG_FILE = Path(
    os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")
) / "omarchy" / "global-menu.json"

_MENU_CONFIG_DEFAULTS = {
    "name": "Omarchy",
    "icon": "omarchy",
    "harvestMenus": False,
    "pollIntervalSec": 0.0,
}
_menu_config_cache = {"mtime": None, "data": dict(_MENU_CONFIG_DEFAULTS)}


def load_menu_config():
    """User overrides for the fallback menu and the popover harvest.

    Reads ~/.config/omarchy/global-menu.json:
      {"fallbackName": "...", "fallbackIcon": "...", "harvestMenus": true,
       "pollIntervalSec": 5}

    `harvestMenus` turns on the last-resort path that opens an app's title-bar
    menus to read them (see PopoverHarvester): it makes menus appear for apps
    that expose none, at the cost of those popups flashing on screen while the
    snapshot is built. Off by default.

    `pollIntervalSec` re-extracts the focused app's menu periodically as a
    catch-all for apps that emit no change signal at all. 0 (the default)
    leaves refresh entirely event-driven. Snapshots that come back identical
    are not re-published, so polling is cheap for static menus.

    Missing/corrupt file or empty values fall back to defaults. Mtime-cached
    so each snapshot build re-reads cheaply and edits apply live.
    """
    try:
        mtime = MENU_CONFIG_FILE.stat().st_mtime
    except OSError:
        mtime = None
    if mtime != _menu_config_cache["mtime"]:
        data = dict(_MENU_CONFIG_DEFAULTS)
        if mtime is not None:
            try:
                parsed = json.loads(MENU_CONFIG_FILE.read_text(encoding="utf-8"))
                if isinstance(parsed, dict):
                    name = str(parsed.get("fallbackName") or "").strip()
                    icon = str(parsed.get("fallbackIcon") or "").strip()
                    if name:
                        data["name"] = name
                    if icon:
                        data["icon"] = icon
                    if "harvestMenus" in parsed:
                        data["harvestMenus"] = parsed.get("harvestMenus") is True
                    if "pollIntervalSec" in parsed:
                        try:
                            interval = float(parsed.get("pollIntervalSec") or 0)
                        except (TypeError, ValueError):
                            interval = 0.0
                        data["pollIntervalSec"] = max(0.0, min(interval, 3600.0))
            except (OSError, json.JSONDecodeError):
                pass
        _menu_config_cache["mtime"] = mtime
        _menu_config_cache["data"] = data
    return _menu_config_cache["data"]


_DESKTOP_CACHE = {}
_EXTRACTION_CACHE = {}  # pid -> {source: timestamp}
_RESPONSIVE_NAMES_CACHE = {}  # pid -> (timestamp, [names])


def get_responsive_names(pid):
    now = time.monotonic()
    if pid in _RESPONSIVE_NAMES_CACHE:
        ts, names = _RESPONSIVE_NAMES_CACHE[pid]
        if now - ts < 15:
            return names
    names = [n for n in _unique_names_for_pid(pid) if _name_responsive(_bus(), n)]
    _RESPONSIVE_NAMES_CACHE[pid] = (now, names)
    if len(_RESPONSIVE_NAMES_CACHE) > 64:
        oldest = min(_RESPONSIVE_NAMES_CACHE, key=lambda k: _RESPONSIVE_NAMES_CACHE[k][0])
        del _RESPONSIVE_NAMES_CACHE[oldest]
    return names


def check_negative_cache(pid, source):
    now = time.monotonic()
    entry = _EXTRACTION_CACHE.get(pid)
    if entry and source in entry:
        if now - entry[source] < 60:
            return True
    return False


def mark_negative_cache(pid, source):
    now = time.monotonic()
    if pid not in _EXTRACTION_CACHE:
        _EXTRACTION_CACHE[pid] = {}
    _EXTRACTION_CACHE[pid][source] = now
    if len(_EXTRACTION_CACHE) > 64:
        # min() over dict_values objects is not orderable, so unwrap the
        # per-pid mapping first: the oldest entry is the one whose most
        # recent negative hit is furthest in the past.
        oldest = min(_EXTRACTION_CACHE, key=lambda k: min(_EXTRACTION_CACHE[k].values()))
        del _EXTRACTION_CACHE[oldest]


def clear_negative_cache(pid, source):
    if pid in _EXTRACTION_CACHE and source in _EXTRACTION_CACHE[pid]:
        del _EXTRACTION_CACHE[pid][source]

DESKTOP_DIRS = [
    Path.home() / ".local/share/applications",
    Path.home() / ".local/share/flatpak/exports/share/applications",
    Path("/usr/local/share/applications"),
    Path("/usr/share/applications"),
    Path("/var/lib/flatpak/exports/share/applications"),
    Path("/var/lib/snapd/desktop/applications"),
]

DEBUG = False


def log(msg):
    if DEBUG:
        print(f"omarchy-global-menu-bridge: {msg}", file=sys.stderr, flush=True)


def hypr_instance_dir():
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
    hypr = runtime / "hypr"
    best = None
    best_mtime = -1
    if hypr.is_dir():
        for entry in hypr.iterdir():
            sock = entry / ".socket2.sock"
            lock = entry / "hyprland.lock"
            if not sock.is_socket():
                continue
            mtime = lock.stat().st_mtime if lock.exists() else 0
            if mtime >= best_mtime:
                best = entry
                best_mtime = mtime
    return best


def run_hyprctl(args, timeout=5.0):
    try:
        proc = subprocess.run(
            ["hyprctl"] + args,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return proc.stdout
    except Exception as exc:  # noqa: BLE001
        log(f"hyprctl {args} failed: {exc}")
        return ""


def active_window():
    raw = run_hyprctl(["-j", "activewindow"])
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


# Windows owned by the shell itself (bar, panels, popup menus). Grabbing
# focus for the menu popup or clicking the bar surfaces these as the active
# window; the global menu must keep the last real app's menu instead of
# switching to a Quickshell fallback.
SHELL_CLASSES = {"org.quickshell", "quickshell"}


def is_shell_window(window):
    window_class = str((window or {}).get("class", "") or "")
    return window_class in SHELL_CLASSES


def find_desktop_file(app_id):
    if not app_id:
        return None
    if app_id in _DESKTOP_CACHE:
        return _DESKTOP_CACHE[app_id]
    candidates = []
    for base in DESKTOP_DIRS:
        if not base.is_dir():
            continue
        exact = base / f"{app_id}.desktop"
        if exact.is_file():
            _DESKTOP_CACHE[app_id] = exact
            return exact
        for desktop in base.glob("*.desktop"):
            candidates.append(desktop)
    # Some apps put a human name in the WM class (Electron often does:
    # "GitHub Desktop" for github-desktop.desktop), so a literal lookup misses
    # and the app ends up with no icon and its WM class as its name. Try the
    # desktop-file spelling too: lowercased, spaces as hyphens.
    aliases = [app_id.lower(), app_id.lower().replace(" ", "-")]
    for alias in aliases:
        if alias == app_id:
            continue
        for base in DESKTOP_DIRS:
            exact = base / f"{alias}.desktop"
            if exact.is_file():
                _DESKTOP_CACHE[app_id] = exact
                return exact
    app_id_l = app_id.lower()
    best = None
    best_score = -1
    for desktop in candidates:
        stem = desktop.stem.lower()
        score = 0
        # Short stems are meaningless as substrings: a one-letter X.desktop
        # ("X") is "in" every app id that contains an x, so any unmatched WM
        # class resolved to it. Require a stem long enough to identify
        # something.
        if len(stem) >= 3 and stem in app_id_l:
            score = 10 + len(stem)
        elif len(app_id_l) >= 3 and app_id_l in stem:
            score = 5
        try:
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            parser.read(desktop)
            wm_class = (parser.get("Desktop Entry", "StartupWMClass", fallback="") or "").lower()
            if wm_class and (wm_class == app_id_l or app_id in wm_class):
                score = max(score, 15)
        except (configparser.Error, OSError):
            continue
        if score > best_score:
            best = desktop
            best_score = score
    # A score of 0 means nothing matched: every candidate merely failed to
    # disagree. Returning one anyway names the app after whichever desktop
    # file the directory listing happened to show first (soffice -> Basecamp),
    # so report no match and let the caller fall back to the WM class.
    if best_score <= 0:
        best = None
    _DESKTOP_CACHE[app_id] = best
    return best


def parse_desktop(path):
    if not path:
        return None
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        parser.read(path)
    except (configparser.Error, OSError):
        return None
    section = "Desktop Entry"
    if not parser.has_section(section):
        return None
    name = parser.get(section, "Name", fallback="")
    icon = parser.get(section, "Icon", fallback="")
    exec_line = parser.get(section, "Exec", fallback="")
    actions_raw = parser.get(section, "Actions", fallback="").strip()
    actions = []
    for action_id in [a for a in actions_raw.split(";") if a.strip()]:
        section_name = f"Desktop Action {action_id}"
        if not parser.has_section(section_name):
            continue
        action_exec = parser.get(section_name, "Exec", fallback="")
        action_name = parser.get(section_name, "Name", fallback=action_id)
        action_icon = parser.get(section_name, "Icon", fallback=icon)
        if action_exec:
            actions.append({"id": action_id, "name": action_name, "exec": action_exec, "icon": action_icon})
    return {"name": name, "icon": icon, "exec": exec_line, "actions": actions}


def clean_exec(exec_line):
    """Strip desktop-file field codes and env prefixes from an Exec line."""
    if not exec_line:
        return ""
    try:
        tokens = shlex.split(exec_line)
    except ValueError:
        return exec_line.strip()
    if not tokens:
        return ""
    if tokens[0] == "env":
        i = 1
        while i < len(tokens) and "=" in tokens[i] and not tokens[i].startswith("="):
            i += 1
        tokens = tokens[i:]
    tokens = [t for t in tokens if not (t.startswith("%") and len(t) > 1)]
    if not tokens:
        return ""
    return shlex.join(tokens)


def clean_menu_label(label):
    """Strip accelerator hints and mnemonics GTK apps embed in labels.

    Two forms arrive over D-Bus and AT-SPI:
      - "<label>\t<accel>" hints, where the tab separates the visible text
        from the shortcut ("Open\tCtrl+O").
      - "_" mnemonics marking the access key ("_File", "Save _As..."). The
        underscore is not rendered by a native menubar, so a label carrying it
        is wrong on the bar (Xournal++ showed "_File", "_Edit", "_Journal").

    A literal "__" is GTK's escape for a real underscore, so it collapses to
    one and is kept: "Save __As" means the user sees "Save _As".
    """
    if not label:
        return ""
    text = str(label).split("\t")[0]
    if "__" in text:
        return text.replace("__", "\0").replace("_", "").replace("\0", "_")
    return text.replace("_", "")


# ---------------------------------------------------------------------------
# org.gtk.Menus extraction (step 2 of the cascade)
#
# GTK3/GtkApplication apps export their menubar over D-Bus with the
# org.gtk.Menus interface (gio g_dbus_connection_export_menu_model). Discovery:
#   1. find the D-Bus unique names owned by the focused window's process
#   2. introspect each name's object tree for an org.gtk.Application object
#   3. the menubar lives at <app object path>/menus/menubar
# Wire format (validated against a real GTK3 exporter):
#   org.gtk.Menus.Start(au group_ids) -> a(uuaa{sv})
#   each entry = (group_id, menu_id, [item_attr_dict, ...]); item attrs carry
#   'label', 'action', 'target', ':submenu'/(g,m), ':section'/(g,m), 'enabled',
#   'hidden-when', 'toggle-type', 'toggle-state'. Root menubar is group 0.
# Activation: org.freedesktop.Application.ActivateAction(action, av params, {}).
# ---------------------------------------------------------------------------

_gio = None


def _gio_import():
    global _gio  # noqa: F811
    if _gio is None:
        import gi  # noqa: PLC0415

        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib  # noqa: PLC0415

        _gio = (Gio, GLib)
    return _gio


_atspi = None


def _atspi_import():
    global _atspi  # noqa: F811
    if _atspi is None:
        import gi  # noqa: PLC0415

        gi.require_version("Atspi", "2.0")
        from gi.repository import Atspi  # noqa: PLC0415

        _atspi = Atspi
    return _atspi


REGISTRAR = None
_dbus = None


def _bus():
    global _dbus  # noqa: F811
    if _dbus is None:
        Gio, _ = _gio_import()
        _dbus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    return _dbus


# --- AT-SPI enablement -------------------------------------------------
#
# at-spi2-core >= 2.62 dropped the org.a11y.Status.ScreenReaderEnabled
# property and re-purposed IsEnabled to mean "some client registered for
# AT-SPI events" (see bus/at-spi-bus-launcher.c). Qt decides whether to
# activate its AT-SPI bridge from exactly that signal:
#
#   enabled = QT_LINUX_ACCESSIBILITY_ALWAYS_ON
#             || status.ScreenReaderEnabled || status.IsEnabled
#
# With neither property set, Qt keeps the bridge off, apps export an empty
# accessible tree, and no menu can be extracted from them (they fall back to
# the synthetic desktop menu). Registering as an event listener is what a
# screen reader does, and it flips IsEnabled on for every app on the bus.
_A11Y_EVENT = "object:state-changed:focused"
_a11y_conn = None


def a11y_bus_address():
    """Address of the accessibility bus (a separate bus from the session one)."""
    addr = os.environ.get("AT_SPI_BUS_ADDRESS")
    if addr:
        return addr
    Gio, _ = _gio_import()
    try:
        reply = _bus().call_sync(
            "org.a11y.Bus",
            "/org/a11y/bus",
            "org.a11y.Bus",
            "GetAddress",
            None,
            None,
            Gio.DBusCallFlags.NONE,
            2000,
        )
        return reply.unpack()[0]
    except Exception as exc:  # noqa: BLE001
        log(f"a11y bus address unavailable: {exc}")
        return None


def enable_atspi(force=False):
    """Register with the a11y registry so apps expose their menus.

    Keeps a connection to the accessibility bus open for the lifetime of the
    process: the launcher watches that name and keeps IsEnabled true only
    while it is owned. Safe to call repeatedly; it re-registers after the
    a11y bus is restarted, and re-announces the registration periodically in
    case the launcher itself was restarted.
    """
    global _a11y_conn  # noqa: F811
    try:
        Gio, GLib = _gio_import()
        if _a11y_conn is not None and _a11y_conn.is_closed():
            _a11y_conn = None
        if _a11y_conn is None:
            addr = a11y_bus_address()
            if not addr:
                return False
            _a11y_conn = Gio.DBusConnection.new_for_address_sync(
                addr,
                Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
                | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
                None,
                None,
            )
            log(f"connected to the accessibility bus as {_a11y_conn.get_unique_name()}")
        _a11y_conn.call_sync(
            "org.a11y.atspi.Registry",
            "/org/a11y/atspi/registry",
            "org.a11y.atspi.Registry",
            "RegisterEvent",
            GLib.Variant("(sass)", (_A11Y_EVENT, [], _a11y_conn.get_unique_name())),
            None,
            Gio.DBusCallFlags.NONE,
            2000,
        )
        if force:
            log(f"re-registered AT-SPI event listener as {_a11y_conn.get_unique_name()}")
        return True
    except Exception as exc:  # noqa: BLE001
        log(f"AT-SPI registration failed: {exc}")
        _a11y_conn = None
        return False


def force_a11y_enabled():
    """Best-effort `org.a11y.Status.IsEnabled = true` on the session bus.

    The registry registration above is the mechanism that keeps this flag
    accurate; this only covers the case where the registry refuses our
    registration but the launcher still honours the property.
    """
    Gio, GLib = _gio_import()
    try:
        _bus().call_sync(
            "org.a11y.Bus",
            "/org/a11y/bus",
            "org.freedesktop.DBus.Properties",
            "Set",
            GLib.Variant("(ssv)", ("org.a11y.Status", "IsEnabled", GLib.Variant("b", True))),
            None,
            Gio.DBusCallFlags.NONE,
            2000,
        )
        log("set org.a11y.Status.IsEnabled = true")
        return True
    except Exception as exc:  # noqa: BLE001
        log(f"could not set org.a11y.Status.IsEnabled: {exc}")
        return False


def _introspect(conn, name, path, timeout=500):
    Gio, _ = _gio_import()
    try:
        reply = conn.call_sync(
            name,
            path,
            "org.freedesktop.DBus.Introspectable",
            "Introspect",
            None,
            None,
            Gio.DBusCallFlags.NONE,
            timeout,
        )
        return reply.unpack()[0]
    except Exception:  # noqa: BLE001
        return None


def _name_responsive(conn, name, timeout=250):
    """Quick probe: does `name` answer introspection at all?

    Some connections (e.g. an app's secondary GUI connection) hang on every
    Introspect call, so crawling their tree would cost `timeout` per node.
    A single fast probe on `/` lets callers skip such names outright.
    """
    xml = _introspect(conn, name, "/", timeout=timeout)
    if xml is None:
        return False
    # A name that owns no exported objects returns an empty <node/>.
    return "<node" in xml


def _unique_names_for_pid(pid):
    """Unique D-Bus names owned by pid or one of its ancestors (GTK apps often
    fork; the GApplication connection may live in the parent process)."""
    Gio, GLib = _gio_import()
    conn = _bus()
    try:
        names = conn.call_sync(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            "ListNames",
            None,
            None,
            Gio.DBusCallFlags.NONE,
            2000,
        ).unpack()[0]
    except Exception:  # noqa: BLE001
        return []
    pids = set()
    cur = pid
    for _ in range(4):
        if not cur:
            break
        pids.add(cur)
        try:
            with open(f"/proc/{cur}/stat") as fh:
                parts = fh.read().split()
            cur = int(parts[3])
        except (OSError, ValueError, IndexError):
            break
    owned = []
    for name in names:
        if not name.startswith(":"):
            continue
        try:
            reply = conn.call_sync(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "GetConnectionUnixProcessID",
                GLib.Variant("(s)", (name,)),
                None,
                Gio.DBusCallFlags.NONE,
                2000,
            )
        except Exception:  # noqa: BLE001
            continue
        if reply.unpack()[0] in pids:
            owned.append(name)
    return owned


def _walk_gtk_app_objects(conn, name, max_depth=5):
    """Object paths on `name` implementing org.gtk.Application."""
    found = []
    budget = [40]  # total Introspect calls per name; systemd's tree is huge

    def walk(path, depth):
        if depth > max_depth or budget[0] <= 0:
            return
        budget[0] -= 1
        xml = _introspect(conn, name, path)
        if xml is None:
            return
        if "org.gtk.Application" in xml:
            found.append(path)
        for line in xml.splitlines():
            line = line.strip()
            if line.startswith("<node name="):
                child = line.split('name="')[1].split('"')[0]
                if child.startswith("/"):
                    walk(child, depth + 1)
                else:
                    walk(path.rstrip("/") + "/" + child, depth + 1)

    walk("/", 0)
    return found


def _serialize_variant(variant):
    """JSON-safe form of a GVariant: {type, data(base64 of serialized bytes)}."""
    GLib = _gio_import()[1]
    try:
        data = variant.get_data()
    except Exception:  # noqa: BLE001
        return None
    return {"type": variant.get_type_string(), "data": base64.b64encode(data).decode("ascii")}


def _action_state_map(conn, name, app_path):
    """Action name -> enabled flag, from org.gtk.Actions.DescribeAll."""
    Gio, _ = _gio_import()
    try:
        reply = conn.call_sync(
            name,
            app_path,
            "org.gtk.Actions",
            "DescribeAll",
            None,
            None,
            Gio.DBusCallFlags.NONE,
            2000,
        )
        return {key: (bool(desc[0]), desc[1]) for key, desc in reply.unpack()[0].items()}
    except Exception:  # noqa: BLE001
        return {}


class GtkMenuExtractor:
    """Pulls a focused GTK app's menubar into the snapshot schema."""

    def __init__(self, pid, app_name, address):
        self.pid = pid
        self.app_name = app_name
        self.address = address
        self.counter = 0
        self.found = None  # (bus_name, app_path, menubar_path)

    def nid(self, prefix):
        self.counter += 1
        return f"{prefix}.{self.counter}"

    def discover(self):
        Gio, _ = _gio_import()
        conn = _bus()
        for name in get_responsive_names(self.pid):
            for app_path in _walk_gtk_app_objects(conn, name):
                menubar_path = app_path.rstrip("/") + "/menus/menubar"
                xml = _introspect(conn, name, menubar_path)
                if xml and "org.gtk.Menus" in xml:
                    self.found = (name, app_path, menubar_path)
                    return True
        return False

    def _start(self, groups):
        Gio, GLib = _gio_import()
        conn = _bus()
        name, _, menubar_path = self.found
        reply = conn.call_sync(
            name,
            menubar_path,
            "org.gtk.Menus",
            "Start",
            GLib.Variant("(au)", (groups,)),
            None,
            Gio.DBusCallFlags.NONE,
            2000,
        )
        return reply.unpack()[0]

    def build(self):
        if not self.discover():
            return None
        Gio, GLib = _gio_import()
        conn = _bus()
        name, app_path, _ = self.found
        states = _action_state_map(conn, name, app_path)

        def describe_action(attrs):
            """(label, action_name, target, enabled, hidden) for an item."""
            action = attrs.get("action")
            enabled = attrs.get("enabled", True)
            hidden = False
            if action:
                base = action.split(".", 1)[1] if "." in action else action
                hw = attrs.get("hidden-when", "")
                known = base in states
                if hw == "action-disabled":
                    hidden = known and not states[base][0]
                elif hw == "action-missing":
                    hidden = not known
                if known:
                    enabled = bool(states[base][0])
            return (
                clean_menu_label(attrs.get("label", "")),
                action,
                attrs.get("target"),
                enabled,
                hidden,
            )

        def action_action(action, target):
            if not action:
                return None
            prefix, _, base = action.partition(".")
            if prefix not in ("app", "win"):
                return None
            action_obj = {
                "kind": "gtk-action",
                "bus": name,
                "path": app_path,
                "action": base,
            }
            if target is not None:
                serialized = _serialize_variant(target)
                if serialized:
                    action_obj["target"] = serialized
            return action_obj

        def separator():
            return {
                "id": self.nid("gtk"),
                "label": "",
                "type": "separator",
                "enabled": False,
                "icon": "",
                "checkState": "none",
                "action": None,
            }

        memo = {}

        def fetch_group(group_id):
            if group_id not in memo:
                memo[group_id] = self._start([group_id])
            return memo[group_id]

        def build_menu(group_id, menu_id, depth=0):
            """Items of one specific menu (group_id, menu_id)."""
            if depth > 6:
                return []
            items = []
            last_section = None
            for gid, mid, attrs_list in fetch_group(group_id):
                if mid != menu_id:
                    continue
                for attrs in attrs_list:
                    label, action, target, enabled, hidden = describe_action(attrs)
                    sub = attrs.get(":submenu")
                    if sub:
                        sg, sm = sub
                        children = build_menu(sg, sm, depth + 1)
                        items.append(
                            {
                                "id": self.nid("gtk"),
                                "label": label,
                                "type": "menu",
                                "enabled": enabled,
                                "icon": "",
                                "checkState": "none",
                                "action": action_action(action, target) if action else None,
                                "items": children,
                            }
                        )
                        continue
                    sec = attrs.get(":section")
                    if sec:
                        sg, sm = sec
                        sub_items = build_menu(sg, sm, depth + 1)
                        if items and last_section != sm:
                            items.append(separator())
                        items.extend(sub_items)
                        last_section = sm
                        continue
                    if hidden:
                        continue
                    items.append(
                        {
                            "id": self.nid("gtk"),
                            "label": label,
                            "type": "item",
                            "enabled": enabled,
                            "icon": "",
                            "checkState": "none",
                            "action": action_action(action, target) if action else None,
                        }
                    )
            return items

        menubar = []
        for gid, mid, attrs_list in fetch_group(0):
            if mid != 0:
                continue  # the root menubar is menu (0, 0); other menus in
                # group 0 are section menus referenced from it
            for attrs in attrs_list:
                label, action, target, enabled, hidden = describe_action(attrs)
                link = attrs.get(":submenu")
                if link:
                    sg, sm = link
                    menubar.append(
                        {
                            "id": self.nid("gtk"),
                            "label": label,
                            "type": "menu",
                            "enabled": enabled,
                            "icon": "",
                            "checkState": "none",
                            "action": action_action(action, target) if action else None,
                            "items": build_menu(sg, sm),
                        }
                    )
                    continue
                section = attrs.get(":section")
                if section:
                    sg, sm = section
                    for entry in build_menu(sg, sm):
                        items = []
                        if entry["type"] == "menu":
                            items = entry["items"]
                        elif entry["type"] == "item":
                            items = [dict(entry, id=self.nid("gtk"))]
                        if not items:
                            continue
                        menubar.append(
                            {
                                "id": self.nid("gtk"),
                                "label": entry["label"],
                                "type": "menu",
                                "enabled": entry["enabled"],
                                "icon": "",
                                "checkState": "none",
                                "action": entry.get("action"),
                                "items": items,
                            }
                        )
                    continue
                if hidden:
                    continue
                items = []
                if action and not link:
                    items = [
                        {
                            "id": self.nid("gtk"),
                            "label": label,
                            "type": "item",
                            "enabled": enabled,
                            "icon": "",
                            "checkState": "none",
                            "action": action_action(action, target),
                        }
                    ]
                menubar.append(
                    {
                        "id": self.nid("gtk"),
                        "label": label,
                        "type": "menu",
                        "enabled": enabled,
                        "icon": "",
                        "checkState": "none",
                        "action": action_action(action, target) if action else None,
                        "items": items,
                    }
                )
        return menubar


def _extract_gtk_menubar(pid, app_name, address):
    try:
        extractor = GtkMenuExtractor(pid, app_name, address)
        menubar = extractor.build()
        return menubar, extractor.found
    except Exception as exc:  # noqa: BLE001
        log(f"org.gtk.Menus extraction failed: {exc}")
        return None, None


# ---------------------------------------------------------------------------
# DBusMenu (com.canonical.dbusmenu) extraction (step 3 of the cascade)
#
# The DBusMenu protocol is what GTK apps export when the appmenu-gtk-module
# is active, plus KDE/libdbusmenu apps (nemo, some electron apps, ...). The
# object implements com.canonical.dbusmenu at a well-known path such as
# /MenuBar. Layout is fetched in one shot with GetLayout(0, -1, []):
#   reply (u, (ia{sv}av)) -> (revision, root); root is (id, props, children)
# where children is an array of variants, each a nested (ia{sv}av) struct.
# Item properties: label, type (normal/separator/checkmark/radio/title),
# enabled, visible, toggle-state, toggle-type, children-display, icon-name.
# Activation: Event(id, "clicked", data, timestamp) -> (b).
# ---------------------------------------------------------------------------

DBUSMENU_PATHS = [
    "/MenuBar",
    "/com/canonical/dbusmenu",
    "/com/canonical/menu",
    "/com/canonical/unity/panel/ApplicationMenus",
]


class DbusMenuExtractor:
    """Pulls a focused app's DBusMenu into the snapshot schema."""

    def __init__(self, pid, app_name, address):
        self.pid = pid
        self.app_name = app_name
        self.address = address
        self.counter = 0
        self.found = None  # (bus_name, object_path)

    def nid(self, prefix):
        self.counter += 1
        return f"{prefix}.{self.counter}"

    def _walk_interface(self, conn, name, path, depth):
        if depth > 6 or self._walk_budget <= 0:
            return None
        self._walk_budget -= 1
        xml = _introspect(conn, name, path)
        if xml is None:
            return None
        if "com.canonical.dbusmenu" in xml:
            return path
        for line in xml.splitlines():
            line = line.strip()
            if line.startswith("<node name="):
                child = line.split('name="')[1].split('"')[0]
                if child.startswith("/"):
                    res = self._walk_interface(conn, name, child, depth + 1)
                else:
                    res = self._walk_interface(conn, name, path.rstrip("/") + "/" + child, depth + 1)
                if res:
                    return res
        return None

    def discover(self):
        Gio, _ = _gio_import()
        conn = _bus()
        self._walk_budget = 40
        for name in get_responsive_names(self.pid):
            for path in DBUSMENU_PATHS:
                xml = _introspect(conn, name, path)
                if xml and "com.canonical.dbusmenu" in xml:
                    self.found = (name, path)
                    return True
            path = self._walk_interface(conn, name, "/", 0)
            if path:
                self.found = (name, path)
                return True
        return False

    def _get_layout(self):
        Gio, GLib = _gio_import()
        conn = _bus()
        name, path = self.found
        reply = conn.call_sync(
            name,
            path,
            "com.canonical.dbusmenu",
            "GetLayout",
            GLib.Variant("(iias)", (0, -1, [])),
            None,
            Gio.DBusCallFlags.NONE,
            2000,
        )
        return reply.unpack()

    def build(self):
        if not self.discover():
            return None
        return self.build_at(*self.found)

    def build_at(self, name, path):
        """Build from an explicit (service, object path), no discovery."""
        self.found = (name, path)
        Gio, _ = _gio_import()
        _, root = self._get_layout()

        def separator():
            return {
                "id": self.nid("dbm"),
                "label": "",
                "type": "separator",
                "enabled": False,
                "icon": "",
                "checkState": "none",
                "action": None,
            }

        def action_for(item_id):
            name, path = self.found
            return {"kind": "dbusmenu-event", "bus": name, "path": path, "id": item_id}

        def build_menu(node, depth=0):
            if depth > 8:
                return []
            items_out = []
            for child in node[2]:
                cid, cprops, cchildren = child
                label = clean_menu_label(str(cprops.get("label") or ""))
                itype = str(cprops.get("type") or "normal")
                if not cprops.get("visible", True):
                    continue
                enabled = bool(cprops.get("enabled", True))
                if itype == "separator":
                    items_out.append(separator())
                    continue
                has_children = bool(cchildren)
                submenu = str(cprops.get("children-display") or "") == "submenu"
                if has_children or submenu:
                    items_out.append(
                        {
                            "id": self.nid("dbm"),
                            "label": label,
                            "type": "menu",
                            "enabled": enabled,
                            "icon": str(cprops.get("icon-name") or ""),
                            "checkState": "none",
                            "action": action_for(cid),
                            "items": build_menu(child, depth + 1),
                        }
                    )
                    continue
                check = "none"
                if itype == "checkmark":
                    check = "check" if cprops.get("toggle-state", 0) else "none"
                elif itype == "radio":
                    check = "radio" if cprops.get("toggle-state", 0) else "none"
                item_type = "item"
                if itype == "title":
                    item_type = "item"
                    enabled = False
                items_out.append(
                    {
                        "id": self.nid("dbm"),
                        "label": label,
                        "type": item_type,
                        "enabled": enabled,
                        "icon": str(cprops.get("icon-name") or ""),
                        "checkState": check,
                        "action": action_for(cid),
                    }
                )
            return items_out

        menubar = []
        nested = 0
        for child in root[2]:
            cid, cprops, _ = child
            if not cprops.get("visible", True):
                continue
            label = clean_menu_label(str(cprops.get("label") or ""))
            if not label and not cprops.get("children-display"):
                # A separator at the root belongs to a flat menu, not a menubar.
                continue
            if cprops.get("children-display"):
                nested += 1
            menubar.append(
                {
                    "id": self.nid("dbm"),
                    "label": label,
                    "type": "menu",
                    "enabled": bool(cprops.get("enabled", True)),
                    "icon": str(cprops.get("icon-name") or ""),
                    "checkState": "none",
                    "action": action_for(cid),
                    "items": build_menu(child),
                }
            )
        # A menubar is a row of submenus (File, Edit, ...). OBS exposes its
        # *tray* menu at /MenuBar - Hide, Open Preview Projector, Start
        # Streaming, Start Recording, ... , Exit - where only two of eight
        # entries have children, and presenting that as the app's menubar put
        # tray commands in the bar as fake top-level menus. Require a majority
        # of submenus: a real menubar is nearly all submenus, a flat or
        # mostly-flat root never is.
        if nested < 2 or nested * 2 < len(menubar):
            log(f"dbusmenu {self.found[1]} is not menubar-shaped ({nested} submenus of {len(menubar)})")
            return None
        return menubar


def _extract_dbusmenu(pid, app_name, address):
    try:
        extractor = DbusMenuExtractor(pid, app_name, address)
        menubar = extractor.build()
        return menubar, extractor.found
    except Exception as exc:  # noqa: BLE001
        log(f"DBusMenu extraction failed: {exc}")
        return None, None


def _extract_dbusmenu_at(service, path):
    """Read a dbusmenu an app registered with the registrar.

    Skips discovery entirely: the registrar already knows the bus name and
    object path, which is the whole point of serving it.
    """
    try:
        extractor = DbusMenuExtractor(0, "", None)
        extractor.found = (service, path)
        menubar = extractor.build_at(service, path)
        return menubar, extractor.found
    except Exception as exc:  # noqa: BLE001
        log(f"DBusMenu extraction at {service} {path} failed: {exc}")
        return None, None


def _registrar_menu_for(address):
    """The (service, path) the registrar holds for a window address, if any."""
    registrar = REGISTRAR
    if registrar is None or not address:
        return None
    return registrar.menu_for_window(address)


class AtspiMenuExtractor:
    """Pulls a focused app's accessibility menubar into the snapshot schema.

    AT-SPI is the deepest fallback: it works for toolkits/apps that expose
    neither org.gtk.Menus nor com.canonical.dbusmenu (GTK apps with a
    traditional menubar, some Electron/Chromium-family apps, etc.).
    """

    # Roles that act as a menubar or open a submenu.
    _MENUBAR_ROLES = {
        "ATSPI_ROLE_MENU_BAR",
        "ATSPI_ROLE_MENU",
    }
    _SUBMENU_ROLES = {
        "ATSPI_ROLE_MENU",
        "ATSPI_ROLE_POPUP_MENU",
    }
    _ITEM_ROLES = {
        "ATSPI_ROLE_MENU_ITEM",
        "ATSPI_ROLE_CHECK_MENU_ITEM",
        "ATSPI_ROLE_RADIO_MENU_ITEM",
        "ATSPI_ROLE_MENU",
    }

    def __init__(self, pid, app_name, address):
        self.pid = pid
        self.app_name = app_name
        self.address = address
        self.counter = 0
        self.found = None  # (app, menubar_accessibles)

    def nid(self, prefix):
        self.counter += 1
        return f"{prefix}.{self.counter}"

    @staticmethod
    def _role(acc):
        try:
            role = acc.get_role()
            return role.value_name if role else ""
        except Exception:  # noqa: BLE001
            return ""

    @staticmethod
    def _name(acc):
        try:
            return (acc.get_name() or "") or ""
        except Exception:  # noqa: BLE001
            return ""

    @staticmethod
    def _state(acc):
        try:
            return acc.get_state_set()
        except Exception:  # noqa: BLE001
            return None

    @staticmethod
    def _enabled(acc):
        states = AtspiMenuExtractor._state(acc)
        if states is None:
            return True
        try:
            return bool(states.contains(_atspi_import().StateType.SENSITIVE))
        except Exception:  # noqa: BLE001
            return True

    @staticmethod
    def _checkstate(acc):
        states = AtspiMenuExtractor._state(acc)
        if states is None:
            return "none"
        try:
            Atspi = _atspi_import()
            role = AtspiMenuExtractor._role(acc)
            if "RADIO" in role:
                if states.contains(Atspi.StateType.CHECKED):
                    return "radio"
            elif "CHECK" in role:
                if states.contains(Atspi.StateType.CHECKED):
                    return "check"
            elif states.contains(Atspi.StateType.CHECKED) or states.contains(Atspi.StateType.SELECTED):
                return "check"
        except Exception:  # noqa: BLE001
            pass
        return "none"

    @staticmethod
    def _visible(acc):
        """Whether an accessible is actually laid out in the app's menu.

        Qt keeps hidden QActions (setVisible(false)) in the accessibility tree,
        but they have no geometry and therefore no AT-SPI Component interface.
        They look like ordinary menu items to a tree walk, which is how stale,
        invisible entries end up in the snapshot. A visible action — even a
        disabled one — always has a Component. The reverse is also true for the
        toolkits we support (GTK exposes Component on its menu items too).
        """
        try:
            return "Component" in {str(iface) for iface in acc.get_interfaces()}
        except Exception:  # noqa: BLE001
            return True  # can't tell -> keep the item

    def _find_role(self, acc, roles, depth=0):
        """First accessible whose role is in `roles` (depth-first)."""
        if depth > 12:
            return None
        if self._role(acc) in roles:
            return acc
        try:
            count = acc.get_child_count()
        except Exception:  # noqa: BLE001
            return None
        if count > 500:
            return None
        for i in range(count):
            try:
                child = acc.get_child_at_index(i)
            except Exception:  # noqa: BLE001
                continue
            if child is None:
                continue
            found = self._find_role(child, roles, depth + 1)
            if found:
                return found
        return None

    def _walk_for_menubar(self, acc, depth=0):
        """Prefer a MENU_BAR; fall back to a MENU with children."""
        menubar = self._find_role(acc, {"ATSPI_ROLE_MENU_BAR"})
        if menubar:
            return menubar
        return self._find_role(acc, {"ATSPI_ROLE_MENU"})

    def discover(self):
        Atspi = _atspi_import()
        try:
            desktop = Atspi.get_desktop(0)
        except Exception as exc:  # noqa: BLE001
            log(f"AT-SPI desktop unavailable: {exc}")
            return False
        try:
            count = desktop.get_child_count()
        except Exception:  # noqa: BLE001
            return False
        for i in range(count):
            try:
                app = desktop.get_child_at_index(i)
            except Exception:  # noqa: BLE001
                continue
            if app is None:
                continue
            try:
                app_pid = app.get_process_id()
            except Exception:  # noqa: BLE001
                continue
            if app_pid != self.pid:
                continue
            menubar = self._walk_for_menubar(app)
            if menubar:
                self.found = (app, menubar)
                return True
        return False

    def _index_of(self, acc):
        try:
            return acc.get_index_in_parent()
        except Exception:  # noqa: BLE001
            return -1

    def _menubar_path(self, menubar):
        """Child-index path from the app accessible down to the menubar."""
        path = []
        app = self.found[0]
        try:
            cur = menubar
            while cur is not None:
                parent = cur.get_parent()
                if parent is None or cur is app:
                    break
                path.append(self._index_of(cur))
                cur = parent
        except Exception:  # noqa: BLE001
            pass
        path.reverse()
        return path

    def _clean_label(self, label):
        return clean_menu_label(label)

    def _extract_children(self, parent_acc, prefix, base_path, depth=0):
        """Convert a menu's child accessibles into snapshot items."""
        if depth > 10:
            return []
        try:
            count = parent_acc.get_child_count()
        except Exception:  # noqa: BLE001
            return []
        children = []
        for i in range(count):
            try:
                child = parent_acc.get_child_at_index(i)
            except Exception:  # noqa: BLE001
                continue
            if child is not None:
                children.append((i, child, self._role(child)))

        # Only filter when this menu is mostly laid-out items. A toolkit that
        # exposes no Component at all would otherwise have its entire menu
        # dropped; the majority check keeps the filter Qt-specific in effect.
        laid_out = [(i, c, r) for i, c, r in children if r in self._ITEM_ROLES]
        visible_count = sum(1 for _, c, _ in laid_out if self._visible(c))
        filter_hidden = bool(laid_out) and visible_count * 2 >= len(laid_out)

        items_out = []
        for i, child, role in children:
            if filter_hidden and role in self._ITEM_ROLES and not self._visible(child):
                log(f"atspi: hiding non-visible menu item {self._name(child)!r}")
                continue
            if role == "ATSPI_ROLE_SEPARATOR":
                items_out.append(
                    {
                        "id": self.nid(prefix),
                        "label": "",
                        "type": "separator",
                        "enabled": False,
                        "icon": "",
                        "checkState": "none",
                        "action": None,
                    }
                )
                continue
            if role not in self._ITEM_ROLES:
                continue
            label = self._clean_label(self._name(child))
            if not label:
                continue
            item_path = base_path + [i]
            submenu = None
            submenu_path = item_path
            try:
                child_count = child.get_child_count()
            except Exception:  # noqa: BLE001
                child_count = 0
            if role == "ATSPI_ROLE_MENU":
                # A menubar entry that is itself a menu: LibreOffice hangs the
                # dropdown's items straight off it, while GTK wraps them in a
                # single POPUP_MENU child. Use the popup when there is one,
                # otherwise the entry is the container.
                popup = None
                for j in range(child_count):
                    try:
                        sub = child.get_child_at_index(j)
                    except Exception:  # noqa: BLE001
                        continue
                    if sub is not None and self._role(sub) == "ATSPI_ROLE_POPUP_MENU":
                        popup = sub
                        submenu_path = item_path + [j]
                        break
                # Never adopt a plain MENU child: inside a dropdown that is a
                # submenu (LibreOffice's File > New), and adopting it rendered
                # its items as the whole menu and left entries whose children
                # are all plain items (Styles, Window, Help) submenu-less.
                submenu = popup if popup is not None else (child if child_count > 0 else None)
            else:
                for j in range(child_count):
                    try:
                        sub = child.get_child_at_index(j)
                    except Exception:  # noqa: BLE001
                        continue
                    if sub is not None and self._role(sub) in ("ATSPI_ROLE_MENU", "ATSPI_ROLE_POPUP_MENU"):
                        submenu = sub
                        submenu_path = item_path + [j]
                        break
            if submenu is not None:
                items_out.append(
                    {
                        "id": self.nid(prefix),
                        "label": label,
                        "type": "menu",
                        "enabled": self._enabled(child),
                        "icon": "",
                        "checkState": self._checkstate(child),
                        "action": None,
                        "items": self._extract_children(submenu, prefix, submenu_path, depth + 1),
                    }
                )
                continue
            items_out.append(
                {
                    "id": self.nid(prefix),
                    "label": label,
                    "type": "item",
                    "enabled": self._enabled(child),
                    "icon": "",
                    "checkState": self._checkstate(child),
                    "action": {"kind": "atspi", "app": self.found[0].get_name() or "", "pid": self.pid, "index": item_path},
                }
            )
        return items_out

    def build(self):
        if not self.discover():
            return None
        _, menubar = self.found
        base_path = self._menubar_path(menubar)
        return self._extract_children(menubar, "atspi", base_path)


def _extract_atspi(pid, app_name, address):
    try:
        extractor = AtspiMenuExtractor(pid, app_name, address)
        menubar = extractor.build()
        return menubar, extractor.found
    except Exception as exc:  # noqa: BLE001
        log(f"AT-SPI extraction failed: {exc}")
        return None, None


def _extract_atspi(pid, app_name, address):
    try:
        extractor = AtspiMenuExtractor(pid, app_name, address)
        menubar = extractor.build()
        return menubar, extractor.found
    except Exception as exc:  # noqa: BLE001
        log(f"AT-SPI extraction failed: {exc}")
        return None, None


# ---------------------------------------------------------------------------
# AT-SPI popover harvest (last real stage of the cascade)
#
# Some apps never expose a MENU_BAR accessible. Zed puts its menubar in the
# title bar as a row of sibling buttons (Zed, File, Edit, Selection, View, Go,
# Run, Window, Help), and each button's dropdown only exists while it is open:
# activating the button creates a MENU accessible, activating it again removes
# it. There is no static menu tree to read, so the only way to see the menu is
# to open it, read it, and close it again.
#
# That is exactly what a screen reader does, and it is visible to the user: the
# popups flash while the snapshot is built. It is therefore opt-in
# (harvestMenus in ~/.config/omarchy/global-menu.json), cached per window title
# so a focus change does not re-flash the menus, and bounded: a title bar with
# fewer than three menu-shaped buttons is left alone, because a lone popover
# (a GTK4 hamburger) is an application menu, not the app's menubar.
# ---------------------------------------------------------------------------

_HARVEST_CACHE = {}
_HARVEST_CACHE_LIMIT = 32
_HARVEST_MIN_BUTTONS = 3
# Harvesting opens and closes a popup for each menu button, which generates a
# burst of AT-SPI events. The change watcher must ignore those or every
# harvest would schedule another refresh of the menu it just harvested.
_HARVESTING = False
_HARVEST_BUTTON_ROLES = {
    "ATSPI_ROLE_TOGGLE_BUTTON",
    "ATSPI_ROLE_PUSH_BUTTON",
    "ATSPI_ROLE_BUTTON",
}


def harvest_enabled():
    return load_menu_config().get("harvestMenus") is True


class PopoverHarvester:
    """Reads a menubar that only exists while each button's popup is open."""

    def __init__(self, pid, app_title):
        self.pid = pid
        self.app_title = app_title or ""
        self.counter = 0
        self.app = None

    def nid(self, prefix):
        self.counter += 1
        return f"{prefix}.{self.counter}"

    @staticmethod
    def _role(acc):
        try:
            role = acc.get_role()
            return role.value_name if role else ""
        except Exception:  # noqa: BLE001
            return ""

    @staticmethod
    def _name(acc):
        try:
            return (acc.get_name() or "") or ""
        except Exception:  # noqa: BLE001
            return ""

    def find_app(self):
        Atspi = _atspi_import()
        try:
            desktop = Atspi.get_desktop(0)
            count = desktop.get_child_count()
        except Exception as exc:  # noqa: BLE001
            log(f"harvest: AT-SPI desktop unavailable: {exc}")
            return None
        for i in range(count):
            try:
                app = desktop.get_child_at_index(i)
            except Exception:  # noqa: BLE001
                continue
            if app is None:
                continue
            try:
                if (app.get_process_id() or 0) == self.pid:
                    self.app = app
                    return app
            except Exception:  # noqa: BLE001
                continue
        return None

    def _menus(self):
        """Every MENU accessible currently under the app, in tree order."""
        found = []

        def walk(acc, depth=0):
            if acc is None or depth > 16:
                return
            if self._role(acc) == "ATSPI_ROLE_MENU":
                found.append(acc)
                return
            try:
                count = acc.get_child_count()
            except Exception:  # noqa: BLE001
                return
            for i in range(count):
                try:
                    walk(acc.get_child_at_index(i), depth + 1)
                except Exception:  # noqa: BLE001
                    continue

        walk(self.app)
        return found

    def _titlebar_buttons(self):
        """Buttons of the window's title-bar strip, if it looks like a menubar.

        Zed puts a TOOL_BAR accessible named "Title bar" at the top of the
        frame, holding 'Zed, File, Edit, Selection, View, Go, Run, Window,
        Help, <project>, Sign In, User menu'. A second TOOL_BAR named "Status
        bar" holds thirteen toggle buttons (Agent Panel, Git Panel, ...) which
        are not menus at all — picking the widest strip by shape alone chose
        that one and harvested nothing.

        So prefer a container whose accessible name says it is the title bar,
        and never one that says it is the status bar. Shape is only the
        fallback, and the caller still proves each button opens a menu before
        trusting it.
        """
        preferred = []
        others = []

        def walk(acc, depth=0):
            if acc is None or depth > 12:
                return
            try:
                container_name = self._name(acc).strip().lower()
            except Exception:  # noqa: BLE001
                container_name = ""
            try:
                count = acc.get_child_count()
            except Exception:  # noqa: BLE001
                return
            buttons = []
            for i in range(count):
                try:
                    child = acc.get_child_at_index(i)
                except Exception:  # noqa: BLE001
                    continue
                if child is None or self._role(child) not in _HARVEST_BUTTON_ROLES:
                    continue
                buttons.append(child)
            if len(buttons) >= _HARVEST_MIN_BUTTONS:
                if "status" in container_name:
                    pass
                elif "title" in container_name:
                    preferred.append((depth, len(buttons), buttons))
                else:
                    others.append((depth, len(buttons), buttons))
            for i in range(count):
                try:
                    walk(acc.get_child_at_index(i), depth + 1)
                except Exception:  # noqa: BLE001
                    continue

        walk(self.app)
        for pool in (preferred, others):
            if pool:
                pool.sort(key=lambda s: (s[0], -s[1]))
                return pool[0][2]
        return []

    def _open(self, button):
        try:
            if button.get_n_actions() < 1:
                return False
            button.do_action(0)
            return True
        except Exception as exc:  # noqa: BLE001
            log(f"harvest: could not open {self._name(button)!r}: {exc}")
            return False

    def _wait_menu(self, timeout=0.5):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            menus = self._menus()
            if menus:
                return menus[0]
            time.sleep(0.03)
        return None

    def _wait_closed(self, timeout=0.5):
        """Wait until no menu is open.

        Every popup here is unnamed with index 0, so a newly opened menu cannot
        be told apart from the previous one by identity: File was harvested
        with Edit's items because the old popup was still in the tree. Waiting
        for the tree to go quiet before the next button is deterministic.
        """
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if not self._menus():
                return True
            time.sleep(0.03)
        return False

    def _harvest_button(self, button):
        """Open a button, read its popup, close it, and settle. Items or None."""
        # 0.5s was too tight: Run, Window and Help timed out intermittently
        # while File/Edit/View opened in ~80ms, which silently dropped real
        # menus. Retry once with a longer window rather than reporting a
        # missing menu.
        for attempt, timeout in enumerate((0.6, 1.2)):
            if not self._open(button):
                continue
            try:
                menu = self._wait_menu(timeout=timeout)
                if menu is not None:
                    return self._items(menu, "harvest", [self._name(button)])
            finally:
                self._open(button)  # close it again
                self._wait_closed()
            if attempt == 0:
                time.sleep(0.1)
        return None

    def _items(self, menu, prefix, path=(), depth=0):
        """One popup's children, in the snapshot schema.

        `path` is the label route from the title-bar button down to this
        popup, so each item can carry where it lives: the item action is
        resolved by re-opening the button and walking that route.
        """
        if depth > 8:
            return []
        items = []
        try:
            count = menu.get_child_count()
        except Exception:  # noqa: BLE001
            return items
        for i in range(count):
            try:
                child = menu.get_child_at_index(i)
            except Exception:  # noqa: BLE001
                continue
            if child is None:
                continue
            role = self._role(child)
            label = clean_menu_label(self._name(child))
            if role == "ATSPI_ROLE_SEPARATOR":
                items.append(
                    {
                        "id": self.nid(prefix),
                        "label": "",
                        "type": "separator",
                        "enabled": False,
                        "icon": "",
                        "checkState": "none",
                        "action": None,
                    }
                )
                continue
            if not label:
                continue
            entry = {
                "id": self.nid(prefix),
                "label": label,
                "type": "item",
                "enabled": True,
                "icon": "",
                "checkState": "none",
                "action": None,
            }
            try:
                states = child.get_state_set()
                entry["enabled"] = bool(states.contains(_atspi_sensitive()))
            except Exception:  # noqa: BLE001
                pass
            # A submenu only exists while hovered for some toolkits; harvest
            # what is already there rather than driving more UI.
            submenu = None
            try:
                for j in range(child.get_child_count()):
                    sub = child.get_child_at_index(j)
                    if sub is not None and self._role(sub) in ("ATSPI_ROLE_MENU", "ATSPI_ROLE_POPUP_MENU"):
                        submenu = sub
                        break
            except Exception:  # noqa: BLE001
                submenu = None
            item_path = list(path) + [label]
            if submenu is not None:
                entry["type"] = "menu"
                entry["action"] = {
                    "kind": "atspi-harvest",
                    "pid": self.pid,
                    "title": self.app_title,
                    "path": item_path,
                }
                entry["items"] = self._items(submenu, prefix, item_path, depth + 1)
            else:
                # Menu items are invoked by walking the same tree again, so
                # the action carries the label path that produced it.
                entry["action"] = {
                    "kind": "atspi-harvest",
                    "pid": self.pid,
                    "title": self.app_title,
                    "path": item_path,
                }
            items.append(entry)
        return items

    def build(self):
        if self.find_app() is None:
            log("harvest: app not on the accessibility bus")
            return None
        buttons = self._titlebar_buttons()
        if len(buttons) < _HARVEST_MIN_BUTTONS:
            log(f"harvest: only {len(buttons)} menu-shaped buttons, not a menubar")
            return None
        menubar = []
        seen = set()
        # The row is read as a run: skip the application menu (index 0, Zed →
        # About/Quit), collect every button that opens a real menu, and stop at
        # the first button that opens nothing (the project button, "Open
        # Recent Project", the account menu). Matching the window title was
        # tried and is unreliable: an empty project's title is "empty project",
        # which matches no button, so Run/Window/Help were followed by
        # "User menu" and a chrome popup landed in the menubar.
        for index, button in enumerate(buttons):
            label = self._name(button)
            if not label or label in seen:
                continue
            if index == 0:
                continue
            items = self._harvest_button(button)
            if not items:
                # A menubar is contiguous: the first button that opens nothing
                # ends it.
                if menubar:
                    break
                continue
            seen.add(label)
            menubar.append(
                {
                    "id": self.nid("harvest"),
                    "label": label,
                    "type": "menu",
                    "enabled": True,
                    "icon": "",
                    "checkState": "none",
                    "action": None,
                    "items": items,
                }
            )
        return menubar or None


def _atspi_sensitive():
    """Atspi.StateType.SENSITIVE, imported once and cached."""
    global _ATSPI_SENSITIVE
    if _ATSPI_SENSITIVE is None:
        _ATSPI_SENSITIVE = _atspi_import().StateType.SENSITIVE
    return _ATSPI_SENSITIVE


_ATSPI_SENSITIVE = None



def _harvest_cache_key(pid, title):
    return (int(pid or 0), str(title or ""))


def harvest_menubar(pid, title):
    """Harvest, reusing the last result for the same window title."""
    global _HARVESTING  # noqa: F811
    key = _harvest_cache_key(pid, title)
    if key in _HARVEST_CACHE:
        return _HARVEST_CACHE[key]
    harvester = PopoverHarvester(pid, title)
    _HARVESTING = True
    try:
        menubar = harvester.build()
    except Exception as exc:  # noqa: BLE001
        log(f"harvest failed: {exc}")
        menubar = None
    finally:
        _HARVESTING = False
    # Cached as-is, including a miss: a title bar that is not a menubar must
    # not be re-probed (and re-flashed) on every subsequent refresh.
    _HARVEST_CACHE[key] = menubar
    if len(_HARVEST_CACHE) > _HARVEST_CACHE_LIMIT:
        _HARVEST_CACHE.pop(next(iter(_HARVEST_CACHE)))
    return menubar


def normalize_menus(menubar):
    """Collapse redundant separators in an extracted menu tree.

    Toolkits collapse them when they lay out a native menu: a separator that
    directly follows another one is given no geometry, so the app shows a
    single line. The accessibility tree still lists both actions, and the bar
    draws one row per action, which would show a double gap the app itself
    never renders.

    Two ways to end up with a redundant separator: the app adds one twice,
    or it hides an action that sat between two of them (Qt drops hidden
    actions from the tree but keeps the separators). Both look the same here,
    so drop any separator that directly follows another one.
    """
    for menu in menubar or []:
        items = menu.get("items")
        if not items:
            continue
        collapsed = []
        for item in items:
            if item.get("type") == "separator" and collapsed and collapsed[-1].get("type") == "separator":
                continue
            collapsed.append(item)
        menu["items"] = collapsed
        normalize_menus([item for item in collapsed if item.get("type") == "menu"])
    return menubar


class SnapshotBuilder:
    def __init__(self, win):
        self.win = win
        self.app_id = win.get("initialClass") or win.get("class") or ""
        self.title = win.get("title") or ""
        self.address = win.get("address") or ""
        self.pid = win.get("pid") or 0
        self.counter = 0
        self.desktop = parse_desktop(find_desktop_file(self.app_id)) if self.app_id else None
        self.app_name = (self.desktop or {}).get("name") or self.app_id or "Desktop"
        self.icon = (self.desktop or {}).get("icon") or ""
        self.app_exec = clean_exec((self.desktop or {}).get("exec") or "")

    def nid(self, prefix):
        self.counter += 1
        return f"{prefix}.{self.counter}"

    def item(self, menu_prefix, label, action=None, enabled=True, icon="", check="none"):
        return {
            "id": self.nid(menu_prefix),
            "label": label,
            "type": "item",
            "enabled": enabled,
            "icon": icon,
            "checkState": check,
            "action": action,
        }

    def separator(self, menu_prefix):
        return {"id": self.nid(menu_prefix), "label": "", "type": "separator", "enabled": False, "icon": "", "checkState": "none", "action": None}

    def hypr(self, lua_expr):
        # Lua dispatcher expression for this Hyprland (0.55+ lua config API),
        # e.g. 'hl.dsp.window.float({ action = "toggle" })'.
        return {"kind": "hypr", "lua": lua_expr}

    def exec_cmd(self, command):
        return {"kind": "exec", "command": command}

    def app_menu(self):
        prefix = "app"
        items = []
        if self.app_exec:
            items.append(self.item(prefix, f"Launch {self.app_name}", self.exec_cmd(self.app_exec)))
        for action in (self.desktop or {}).get("actions", []):
            items.append(self.item(prefix, action["name"], self.exec_cmd(clean_exec(action["exec"])), icon=action["icon"]))
        if items:
            items.append(self.separator(prefix))
        items.append(self.item(prefix, "Close Window", self.hypr(f'hl.dsp.window.close({{ window = "address:{self.address}" }})')))
        items.append(self.item(prefix, "Quit", self.hypr(f'hl.dsp.window.kill({{ window = "address:{self.address}" }})')))
        return {"id": "app", "label": self.app_name, "type": "menu", "items": items}

    def file_menu(self):
        prefix = "file"
        items = []
        if self.app_exec:
            items.append(self.item(prefix, "New Window", self.exec_cmd(self.app_exec)))
            items.append(self.separator(prefix))
        items.append(self.item(prefix, "Close Window", self.hypr(f'hl.dsp.window.close({{ window = "address:{self.address}" }})')))
        items.append(self.item(prefix, "Quit Application", self.hypr(f'hl.dsp.window.kill({{ window = "address:{self.address}" }})')))
        return {"id": "file", "label": "File", "type": "menu", "items": items}

    def edit_menu(self):
        return {"id": "edit", "label": "Edit", "type": "menu", "items": [
            self.item("edit", "Copy", None, enabled=False),
            self.item("edit", "Paste", None, enabled=False),
        ]}

    def view_menu(self):
        prefix = "view"
        return {"id": "view", "label": "View", "type": "menu", "items": [
            self.item(prefix, "Toggle Floating", self.hypr('hl.dsp.window.float({ action = "toggle" })')),
            self.item(prefix, "Toggle Fullscreen", self.hypr('hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" })')),
        ]}

    def window_menu(self):
        prefix = "window"
        return {"id": "window", "label": "Window", "type": "menu", "items": [
            self.item(prefix, "Next Workspace", self.hypr('hl.dsp.focus({ workspace = "e+1" })')),
            self.item(prefix, "Previous Workspace", self.hypr('hl.dsp.focus({ workspace = "e-1" })')),
            self.separator(prefix),
            self.item(prefix, "Move Left", self.hypr('hl.dsp.window.move({ direction = "l" })')),
            self.item(prefix, "Move Right", self.hypr('hl.dsp.window.move({ direction = "r" })')),
            self.item(prefix, "Move Up", self.hypr('hl.dsp.window.move({ direction = "u" })')),
            self.item(prefix, "Move Down", self.hypr('hl.dsp.window.move({ direction = "d" })')),
            self.separator(prefix),
            self.item(prefix, "Send to Scratchpad", self.hypr('hl.dsp.window.move({ workspace = "special:scratchpad", follow = true })')),
        ]}

    def help_menu(self):
        prefix = "help"
        return {"id": "help", "label": "Help", "type": "menu", "items": [
            self.item(prefix, "Launch Terminal", self.exec_cmd("xdg-terminal-exec")),
        ]}

    def omarchy_menu(self):
        """Default 'Omarchy' app menu shown when no app window is focused,
        mirroring macOS where the Finder menu always fills the bar.
        Label/icon come from ~/.config/omarchy/global-menu.json when set."""
        cfg = load_menu_config()
        prefix = "omarchy"
        items = [
            self.item(prefix, f"About {cfg['name']}", self.exec_cmd("omarchy-launch-about")),
            self.separator(prefix),
            self.item(prefix, "Launch Terminal", self.exec_cmd("xdg-terminal-exec")),
            self.item(prefix, "Capture Screenshot", self.exec_cmd("omarchy-capture-screenshot")),
            self.separator(prefix),
            self.item(prefix, "Lock Screen", self.exec_cmd("omarchy-system-lock")),
            self.item(prefix, "Logout", self.exec_cmd("omarchy-system-logout")),
            self.separator(prefix),
            self.item(prefix, "Reboot", self.exec_cmd("omarchy-system-reboot")),
            self.item(prefix, "Shutdown", self.exec_cmd("omarchy-system-shutdown")),
        ]
        return {"id": prefix, "label": cfg["name"], "type": "menu", "items": items}

    def obs_file_menu(self):
        prefix = "obs_file"
        return {
            "id": prefix,
            "label": "File",
            "type": "menu",
            "items": [
                self.item(prefix, "Settings", self.exec_cmd("obs --settings")),
                self.separator(prefix),
                self.item(prefix, "Close Window", self.hypr(f'hl.dsp.window.close({{ window = "address:{self.address}" }})')),
                self.item(prefix, "Exit", self.hypr(f'hl.dsp.window.kill({{ window = "address:{self.address}" }})')),
            ],
        }

    def obs_edit_menu(self):
        prefix = "obs_edit"
        return {
            "id": prefix,
            "label": "Edit",
            "type": "menu",
            "items": [
                self.item(prefix, "Undo", None, enabled=False),
                self.item(prefix, "Redo", None, enabled=False),
                self.separator(prefix),
                self.item(prefix, "Cut", None, enabled=False),
                self.item(prefix, "Copy", None, enabled=False),
                self.item(prefix, "Paste", None, enabled=False),
                self.separator(prefix),
                self.item(prefix, "Lock Preview", None, enabled=True),
            ],
        }

    def obs_view_menu(self):
        prefix = "obs_view"
        return {
            "id": prefix,
            "label": "View",
            "type": "menu",
            "items": [
                self.item(prefix, "Toggle Fullscreen", self.hypr('hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" })')),
            ],
        }

    def obs_docks_menu(self):
        prefix = "obs_docks"
        return {
            "id": prefix,
            "label": "Docks",
            "type": "menu",
            "items": [
                self.item(prefix, "Audio Mixer", None, enabled=True),
                self.item(prefix, "Controls", None, enabled=True),
                self.item(prefix, "Scene Transitions", None, enabled=True),
                self.item(prefix, "Scenes", None, enabled=True),
                self.item(prefix, "Sources", None, enabled=True),
            ],
        }

    def obs_profile_menu(self):
        prefix = "obs_profile"
        return {
            "id": prefix,
            "label": "Profile",
            "type": "menu",
            "items": [
                self.item(prefix, "New", None, enabled=True),
                self.item(prefix, "Duplicate", None, enabled=True),
                self.item(prefix, "Rename", None, enabled=True),
                self.item(prefix, "Remove", None, enabled=True),
            ],
        }

    def obs_scene_collection_menu(self):
        prefix = "obs_sc"
        return {
            "id": prefix,
            "label": "Scene Collection",
            "type": "menu",
            "items": [
                self.item(prefix, "New", None, enabled=True),
                self.item(prefix, "Duplicate", None, enabled=True),
                self.item(prefix, "Rename", None, enabled=True),
                self.item(prefix, "Remove", None, enabled=True),
            ],
        }

    def obs_tools_menu(self):
        prefix = "obs_tools"
        return {
            "id": prefix,
            "label": "Tools",
            "type": "menu",
            "items": [
                self.item(prefix, "Auto-Configuration Wizard", None, enabled=True),
                self.item(prefix, "Scripts", None, enabled=True),
            ],
        }

    def obs_help_menu(self):
        prefix = "obs_help"
        return {
            "id": prefix,
            "label": "Help",
            "type": "menu",
            "items": [
                self.item(prefix, "Check for Updates", None, enabled=True),
                self.item(prefix, "Log Files", None, enabled=True),
                self.separator(prefix),
                self.item(prefix, "About OBS Studio", self.exec_cmd("omarchy-launch-about")),
            ],
        }


    def _build(self):
        base = {
            "appId": self.app_id,
            "appName": self.app_name,
            "icon": self.icon,
            "title": self.title,
        }
        if not self.app_id:
            cfg = load_menu_config()
            base.update(
                {
                    "appName": cfg["name"],
                    "icon": cfg["icon"],
                    "title": "",
                    "source": "none",
                    "menubar": [self.omarchy_menu()],
                }
            )
            return base

        app_id_lower = self.app_id.lower()
        if "steam" in app_id_lower:
            base["source"] = "desktop-fallback"
            base["menubar"] = [
                self.app_menu(),
                self.file_menu(),
                self.edit_menu(),
                self.view_menu(),
                self.window_menu(),
                self.help_menu(),
            ]
            return base

        if "firefox" in app_id_lower or "librewolf" in app_id_lower:
            base["source"] = "desktop-fallback"
            base["menubar"] = [
                self.app_menu(),
                self.file_menu(),
                self.edit_menu(),
                self.view_menu(),
                self.window_menu(),
                self.help_menu(),
            ]
            return base

        if ("obs" in app_id_lower and "obsidian" not in app_id_lower) or ("studio" in app_id_lower and "obsidian" not in app_id_lower):
            base["source"] = "curated-fallback"
            base["menubar"] = [
                self.obs_file_menu(),
                self.obs_edit_menu(),
                self.obs_view_menu(),
                self.obs_docks_menu(),
                self.obs_profile_menu(),
                self.obs_scene_collection_menu(),
                self.obs_tools_menu(),
                self.obs_help_menu(),
            ]
            return base

        if not check_negative_cache(self.pid, "org.gtk.Menus"):
            gtk_menubar, found = _extract_gtk_menubar(self.pid, self.app_name, self.address)
            if gtk_menubar:
                clear_negative_cache(self.pid, "org.gtk.Menus")
                base.update(
                    {
                        "source": "org.gtk.Menus",
                        "dbus": {"name": found[0], "app": found[1]},
                        "menubar": normalize_menus(gtk_menubar),
                    }
                )
                return base
            else:
                mark_negative_cache(self.pid, "org.gtk.Menus")

        if not check_negative_cache(self.pid, "dbusmenu"):
            # A registered window already told us where its menu is; go
            # straight there instead of guessing object paths.
            registered = _registrar_menu_for(self.address)
            dbusmenu, found = None, None
            if registered:
                dbusmenu, found = _extract_dbusmenu_at(registered[0], registered[1])
                if dbusmenu:
                    log(f"dbusmenu via registrar: {registered[0]} {registered[1]}")
            if not dbusmenu:
                dbusmenu, found = _extract_dbusmenu(self.pid, self.app_name, self.address)
            if dbusmenu:
                clear_negative_cache(self.pid, "dbusmenu")
                base.update(
                    {
                        "source": "dbusmenu",
                        "dbus": {"name": found[0], "path": found[1]},
                        "menubar": normalize_menus(dbusmenu),
                    }
                )
                return base
            else:
                mark_negative_cache(self.pid, "dbusmenu")

        if not check_negative_cache(self.pid, "at-spi"):
            atspi, _ = _extract_atspi(self.pid, self.app_name, self.address)
            if atspi:
                clear_negative_cache(self.pid, "at-spi")
                base.update({"source": "at-spi", "menubar": normalize_menus(atspi)})
                return base
            else:
                mark_negative_cache(self.pid, "at-spi")

        # Last real stage: apps whose menubar is a row of title-bar buttons and
        # whose menu only exists while a button's popup is open (Zed). Opt-in
        # because harvesting flashes those popups on screen.
        #
        # No negative caching here: harvest is already memoised per (pid,
        # title) in _HARVEST_CACHE, and the 60s extraction cache is the wrong
        # tool because an app that is not yet on the accessibility bus (started
        # before the a11y listener, or still opening its window) misses once
        # and would then stay menu-less for a minute even after it is ready.
        if harvest_enabled():
            harvested = harvest_menubar(self.pid, self.title)
            if harvested:
                base.update({"source": "harvest", "menubar": normalize_menus(harvested)})
                return base

        base["source"] = "desktop-fallback"
        base["menubar"] = [
            self.app_menu(),
            self.file_menu(),
            self.edit_menu(),
            self.view_menu(),
            self.window_menu(),
            self.help_menu(),
        ]
        return base

    def build(self):
        snapshot = self._build()
        ensure_app_separator(snapshot.get("menubar"))
        return snapshot


def ensure_private_state():
    """Make the state directory and any existing state files private.

    With a default umask of 022, Path.mkdir/write_text would leave
    ~/.local/state/omarchy/global-menu at 0755 and active.json at 0644,
    readable by any other local UID. Keep them at 0700/0600 instead, and
    repair files written by earlier (insecure) runs.
    """
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(STATE_DIR, 0o700)
    except OSError:
        pass
    for path in (ACTIVE_FILE, REQUEST_FILE):
        try:
            mode = os.stat(path).st_mode & 0o7777
            if mode & 0o077:
                os.chmod(path, 0o600)
        except OSError:
            pass
    # Drop leftover temp files from earlier (insecure) runs so a world-readable
    # active.tmp/request.tmp left behind by an interrupted write cannot linger
    # after the upgrade.
    try:
        for leftover in STATE_DIR.glob("*.tmp"):
            try:
                leftover.unlink()
            except OSError:
                pass
    except OSError:
        pass


def _open_private_temp(path):
    """Open a fresh, private temp file next to path with exclusive creation.

    O_EXCL guarantees we never truncate and reuse an existing inode: a leftover
    temp from a crashed earlier run (possibly still world-readable) causes
    FileExistsError and we move on to a new unique name. The created mode is
    0600, which a umask of 022/077 cannot widen to group/other.
    """
    pid = os.getpid()
    last_exc = None
    for attempt in range(10000):
        tmp = path.with_name(f".{path.name}.{pid}.{attempt}.tmp")
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError as exc:
            last_exc = exc
            continue
        except OSError as exc:
            last_exc = exc
            continue
        return fd, tmp
    raise last_exc or OSError(f"could not create a private temp file next to {path}")


def write_private_text(path, text):
    """Write text to path via a fresh private temp file, then atomically replace.

    The temp file is created with O_CREAT|O_EXCL so an inode left behind by an
    interrupted earlier write is never truncated and reused (which would
    preserve its old, possibly world-readable, mode). The temp is written at
    0600, fsynced, and moved onto path with os.replace(), so readers never see
    a partial write and the replacement inherits the private mode.
    """
    fd, tmp = _open_private_temp(path)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    os.replace(tmp, path)


def write_snapshot(snapshot):
    ensure_private_state()
    write_private_text(ACTIVE_FILE, json.dumps(snapshot, ensure_ascii=False))


def ensure_app_separator(menubar):
    """Ensure a '|' item sits between the app menu and the rest of the bar.

    Some apps (Devpad) ship a native '|' top-level item; most others don't.
    Normalizing here keeps the strip consistent regardless of which extraction
    path produced it. Applied after every build, including all early returns.
    """
    if not isinstance(menubar, list) or len(menubar) < 2:
        return menubar
    second = menubar[1]
    if isinstance(second, dict) and clean_menu_label(second.get("label", "")) == "|":
        return menubar
    menubar.insert(
        1,
        {
            "id": "app-menu-separator",
            "label": "|",
            "type": "separator",
            "enabled": False,
            "icon": "",
            "checkState": "none",
            "action": None,
            "items": [],
        },
    )
    return menubar


def snapshot_signature(snapshot):
    """Content signature of a snapshot, ignoring generated ids and title.

    Extractors number items from scratch on every build, and all at-spi
    actions store an index path that shifts whenever an item is inserted.
    A byte-for-byte compare would therefore call even an unchanged rebuild a
    change, rewriting active.json and making the bar reload (and reshape an
    open popup) for nothing. The window title changes on every keystroke in
    most editors and is not rendered by the widget, so it is ignored too.
    """
    def strip(value):
        if isinstance(value, dict):
            return {key: strip(item) for key, item in value.items() if key != "id"}
        if isinstance(value, list):
            return [strip(item) for item in value]
        return value

    data = strip(snapshot)
    data.pop("title", None)  # top-level window title only; harvest actions keep theirs
    return json.dumps(data, sort_keys=True, ensure_ascii=False)


def load_item_map(snapshot):
    mapping = {}

    def walk(menu, parent_id=""):
        for item in menu.get("items", []):
            mapping[item["id"]] = item
            if item.get("type") == "menu":
                walk(item, item["id"])

    for menu in snapshot.get("menubar", []):
        mapping[menu["id"]] = menu
        walk(menu, menu["id"])
    return mapping


def execute_action(action):
    if not action:
        return False
    kind = action.get("kind")
    if kind == "hypr":
        expr = action.get("lua") or ""
        if not expr:
            return False
        run_hyprctl(["dispatch", expr])
        return True
    if kind == "exec":
        command = action.get("command") or ""
        if not command:
            return False
        subprocess.Popen(["sh", "-c", command], start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    if kind == "gtk-action":
        return _execute_gtk_action(action)
    if kind == "dbusmenu-event":
        return _execute_dbusmenu_event(action)
    if kind == "atspi":
        return _execute_atspi_action(action)
    if kind == "atspi-harvest":
        return _execute_harvest_action(action)
    log(f"unknown action kind: {kind}")
    return False


def _execute_harvest_action(action):
    """Re-open a harvested popup and click the item at its label path.

    A harvested item has no standalone accessible to invoke: it only exists
    while its button's popup is open. So open the top-level button again, walk
    the popup by label, then do_action on the item — which also closes the
    menu, because the app treats the activation as a click on it.
    """
    pid = action.get("pid") or 0
    path = action.get("path") or []
    if not pid or not path:
        return False
    harvester = PopoverHarvester(pid, action.get("title") or "")
    if harvester.find_app() is None:
        log("harvest activate: app not on the accessibility bus")
        return False
    top = path[0]
    button = None
    for candidate in harvester._titlebar_buttons():
        if harvester._name(candidate) == top:
            button = candidate
            break
    if button is None:
        log(f"harvest activate: no title-bar button {top!r}")
        return False
    if not harvester._open(button):
        return False
    menu = harvester._wait_menu()
    if menu is None:
        return False
    node = menu
    for label in path[1:]:
        found = None
        try:
            for i in range(node.get_child_count()):
                child = node.get_child_at_index(i)
                if child is not None and clean_menu_label(harvester._name(child)) == label:
                    found = child
                    break
        except Exception:  # noqa: BLE001
            found = None
        if found is None:
            harvester._open(button)
            log(f"harvest activate: {label!r} not found under {top!r}")
            return False
        node = found
        # Descend into a submenu if that is what the label names.
        try:
            for j in range(node.get_child_count()):
                sub = node.get_child_at_index(j)
                if sub is not None and harvester._role(sub) in ("ATSPI_ROLE_MENU", "ATSPI_ROLE_POPUP_MENU"):
                    node = sub
                    break
        except Exception:  # noqa: BLE001
            pass
    try:
        if node.get_n_actions() < 1:
            harvester._open(button)
            log("harvest activate: item has no actions")
            return False
        node.do_action(0)
        return True
    except Exception as exc:  # noqa: BLE001
        log(f"harvest activate failed: {exc}")
        return False


# ---------------------------------------------------------------------------
# com.canonical.AppMenu.Registrar (the layer that makes this global)
#
# Every toolkit that has a real menubar exports it in one of three ways, and
# two of them only export at all when something is *listening*:
#
#   Qt6/KDE (Krita, Kate, Dolphin)
#       libQt6Gui contains RegisterWindow/UnregisterWindow/GetMenuForWindow
#       and the com.canonical.dbusmenu strings, but it registers with
#       org.kde.kappmenu (Plasma) or com.canonical.AppMenu.Registrar
#       (Unity/vala-panel). With neither present it exports nothing.
#   LibreOffice (GTK3 VCL)
#       libvclplug_gtk3lo.so imports com.canonical.AppMenu.Registrar and only
#       hides its own menubar once the registrar replies.
#   GTK3 apps
#       need appmenu-gtk-module, which likewise exports to the registrar.
#
# So the reason a Plasma session "just works" is not Plasma magic: Plasma's
# kded appmenu module *is* the registrar. Owning that name here gives the same
# reach to this bridge, with no KDE installed, and it stops LibreOffice from
# drawing a second copy of the menus the bar already shows.
#
# Interface (freedesktop appmenu spec):
#   RegisterWindow(o window, o menu)        -> ()
#   UnregisterWindow(o window)              -> ()
#   GetMenuForWindow(u window)              -> (so)   [deprecated]
#   GetMenus                               -> a(uso)  {window, service, path}
#   signals: WindowRegistered(u window, s service), WindowUnregistered(u window)
# ---------------------------------------------------------------------------

REGISTRAR_NAME = "com.canonical.AppMenu.Registrar"
REGISTRAR_PATH = "/com/canonical/AppMenu/Registrar"
REGISTRAR_XML = """
<node>
  <interface name="com.canonical.AppMenu.Registrar">
    <method name="RegisterWindow">
      <arg type="u" name="windowId" direction="in"/>
      <arg type="o" name="menuObjectPath" direction="in"/>
    </method>
    <method name="UnregisterWindow">
      <arg type="u" name="windowId" direction="in"/>
    </method>
    <method name="GetMenuForWindow">
      <arg type="u" name="windowId" direction="in"/>
      <arg type="s" name="service" direction="out"/>
      <arg type="o" name="menuObjectPath" direction="out"/>
    </method>
    <method name="GetMenus">
      <arg type="a(uso)" name="menus" direction="out"/>
    </method>
    <signal name="WindowRegistered">
      <arg type="u" name="windowId"/>
      <arg type="s" name="service"/>
    </signal>
    <signal name="WindowUnregistered">
      <arg type="u" name="windowId"/>
    </signal>
  </interface>
</node>
"""


class AppMenuRegistrar:
    """Serves com.canonical.AppMenu.Registrar and keeps the window -> menu map.

    Ownership matters more than the contents: an app checks that the name is
    taken before exporting, so a registrar that answers but stores nothing
    still makes Qt and LibreOffice publish their menus. Every registered
    window is kept so extraction can go straight to dbusmenu for it.
    """

    def __init__(self):
        self.conn = None
        self.registration_id = 0
        self.menus = {}  # window id -> (service, object path)
        self.node_info = None

    def _on_call(self, conn, sender, path, iface, method, params, invocation):
        try:
            self._dispatch(conn, sender, method, params, invocation)
        except Exception as exc:  # noqa: BLE001
            log(f"registrar: {method} failed: {exc}")
            try:
                invocation.return_dbus_error(REGISTRAR_NAME + ".Failed", str(exc))
            except Exception:  # noqa: BLE001
                pass

    def _dispatch(self, conn, sender, method, params, invocation):
        Gio, GLib = _gio_import()
        if method == "RegisterWindow":
            window_id, menu_path = params.unpack()
            self.menus[int(window_id)] = (str(sender), str(menu_path))
            log(f"registrar: window {window_id} -> {sender} {menu_path}")
            invocation.return_value(None)
            return
        if method == "UnregisterWindow":
            (window_id,) = params.unpack()
            if self.menus.pop(int(window_id), None) is not None:
                log(f"registrar: window {window_id} unregistered")
            invocation.return_value(None)
            return
        if method == "GetMenuForWindow":
            (window_id,) = params.unpack()
            service, path = self.menus.get(int(window_id), ("", "/"))
            invocation.return_value(GLib.Variant("(so)", (service, path)))
            return
        if method == "GetMenus":
            entries = [(int(win), service, path) for win, (service, path) in sorted(self.menus.items())]
            invocation.return_value(GLib.Variant("(a(uso))", (entries,)))
            return
        invocation.return_dbus_error(
            "org.freedesktop.DBus.Error.UnknownMethod", f"no such method {method}"
        )

    def start(self):
        """Take the well-known name. Returns False when another registrar owns it."""
        Gio, GLib = _gio_import()
        try:
            conn = _bus()
            node = Gio.DBusNodeInfo.new_for_xml(REGISTRAR_XML)
        except Exception as exc:  # noqa: BLE001
            log(f"registrar: could not build interface: {exc}")
            return False
        interface = node.interfaces[0]
        try:
            self.registration_id = conn.register_object(
                REGISTRAR_PATH,
                interface,
                self._on_call,
                None,
                None,
            )
        except Exception as exc:  # noqa: BLE001
            log(f"registrar: could not register object: {exc}")
            return False
        if not self.registration_id:
            log("registrar: object registration refused")
            return False
        try:
            reply = conn.call_sync(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "RequestName",
                GLib.Variant("(su)", (REGISTRAR_NAME, 0x4)),  # DO_NOT_QUEUE
                None,
                Gio.DBusCallFlags.NONE,
                2000,
            )
            result = reply.unpack()[0]
        except Exception as exc:  # noqa: BLE001
            log(f"registrar: RequestName failed: {exc}")
            return False
        # 1 = primary owner, 4 = already owner. Anything else means another
        # registrar (Plasma's, say) holds it; leave theirs alone.
        if result not in (1, 4):
            log(f"registrar: name taken by another process (result={result})")
            return False
        self.conn = conn
        log(f"registrar: serving {REGISTRAR_NAME}")
        return True

    def menu_for_window(self, window_address):
        """(service, path) registered for a Hyprland window address, or None.

        Apps register X11/Wayland window ids, which Hyprland reports as a hex
        address. Only the low 32 bits are meaningful for X11 windows, so match
        the numeric value rather than the string.
        """
        try:
            wanted = int(str(window_address), 16)
        except (TypeError, ValueError):
            return None
        for window_id, entry in self.menus.items():
            if window_id == wanted:
                return entry
        return None


def _execute_gtk_action(action):
    """Fire a GTK action via org.freedesktop.Application.ActivateAction."""
    Gio, GLib = _gio_import()
    try:
        conn = _bus()
        params = []
        target = action.get("target")
        if target:
            variant = GLib.Variant.new_from_bytes(
                GLib.VariantType.new(target["type"]),
                GLib.Bytes.new(base64.b64decode(target["data"])),
            )
            params.append(variant)
        conn.call_sync(
            action.get("bus"),
            action.get("path"),
            "org.freedesktop.Application",
            "ActivateAction",
            GLib.Variant("(sava{sv})", (action.get("action", ""), params, {})),
            None,
            Gio.DBusCallFlags.NONE,
            5000,
        )
        return True
    except Exception as exc:  # noqa: BLE001
        log(f"gtk-action failed: {exc}")
        return False


def _execute_dbusmenu_event(action):
    """Fire a DBusMenu item via Event(id, 'clicked', data, timestamp)."""
    Gio, GLib = _gio_import()
    try:
        conn = _bus()
        reply = conn.call_sync(
            action.get("bus"),
            action.get("path"),
            "com.canonical.dbusmenu",
            "Event",
            GLib.Variant("(isvu)", (action.get("id"), "clicked", GLib.Variant("s", ""), 0)),
            None,
            Gio.DBusCallFlags.NONE,
            5000,
        )
        handled = reply.unpack()[0]
        log(f"dbusmenu Event({action.get('id')}, clicked) handled={handled}")
        return bool(handled)
    except Exception as exc:  # noqa: BLE001
        log(f"dbusmenu-event failed: {exc}")
        return False


def _execute_atspi_action(action):
    """Invoke an AT-SPI menu item by re-resolving its child-index path."""
    Atspi = _atspi_import()
    app_name = action.get("app") or ""
    pid = action.get("pid") or 0
    index_path = action.get("index") or []
    if not index_path:
        return False
    try:
        desktop = Atspi.get_desktop(0)
        count = desktop.get_child_count()
        candidates = []
        for i in range(count):
            try:
                app = desktop.get_child_at_index(i)
            except Exception:  # noqa: BLE001
                continue
            if app is None:
                continue
            if pid and (app.get_process_id() or 0) == pid:
                candidates.append(app)
            elif not pid and (app.get_name() or "") == app_name:
                candidates.append(app)
        if not candidates:
            log("atspi: app not found in AT-SPI desktop")
            return False
        for target_app in candidates:
            acc = target_app
            ok = True
            for idx in index_path:
                try:
                    acc = acc.get_child_at_index(idx)
                except Exception:  # noqa: BLE001
                    ok = False
                    break
                if acc is None:
                    ok = False
                    break
            if not ok:
                continue
            n = acc.get_n_actions()
            if n < 1:
                log(f"atspi: item '{acc.get_name() or ''}' has no actions")
                return False
            acc.do_action(0)
            log(f"atspi: do_action(0) on '{acc.get_name() or ''}'")
            return True
        log("atspi: index path did not resolve in any matching app")
        return False
    except Exception as exc:  # noqa: BLE001
        log(f"atspi-action failed: {exc}")
        return False


def handle_requests(item_map):
    if not REQUEST_FILE.is_file():
        return
    try:
        data = json.loads(REQUEST_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        log(f"bad request: {exc}")
        try:
            REQUEST_FILE.unlink()
        except OSError:
            pass
        return
    try:
        REQUEST_FILE.unlink()
    except OSError:
        pass
    if not isinstance(data, dict):
        return
    action = data.get("action")
    if isinstance(action, dict):
        execute_action(action)
        return
    item_id = data.get("id")
    if not item_id:
        return
    item = item_map.get(item_id)
    if item is None:
        log(f"unknown item id: {item_id}")
        return
    execute_action(item.get("action"))


def connect_events():
    instance = hypr_instance_dir()
    if not instance:
        return None
    path = instance / ".socket2.sock"
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(str(path))
        sock.setblocking(False)
        return sock
    except OSError as exc:
        log(f"connect {path}: {exc}")
        return None


class MenuChangeWatcher:
    """Subscribes to the focused app's menu-change signals.

    org.gtk.Menus apps emit Changed(au) when their menu structure updates;
    DBusMenu apps emit LayoutUpdated(ia{sv}) similarly. While the user keeps
    the same window focused, these fire when items toggle or appear, so the
    daemon can refresh the snapshot without waiting for a focus change.
    """

    def __init__(self):
        self.subscription = 0
        self.conn = None
        self.on_change = None

    def _signal_cb(self, conn, sender, obj_path, iface, signal, params, user_data):
        log(f"menu change signal: {signal}")
        cb = self.on_change
        if cb:
            cb()

    def watch(self, snapshot, on_change):
        self.clear()
        source = snapshot.get("source")
        dbus = snapshot.get("dbus") or {}
        name = dbus.get("name")
        if source == "org.gtk.Menus" and name:
            path = str(dbus.get("app") or "").rstrip("/") + "/menus/menubar"
            interface, member = "org.gtk.Menus", "Changed"
        elif source == "dbusmenu" and name:
            path = str(dbus.get("path") or "")
            interface, member = "com.canonical.dbusmenu", "LayoutUpdated"
        else:
            return
        if not path:
            return
        Gio, _ = _gio_import()
        self.conn = _bus()
        self.on_change = on_change
        try:
            self.subscription = self.conn.signal_subscribe(
                name,
                interface,
                member,
                path,
                None,
                Gio.DBusSignalFlags.NONE,
                self._signal_cb,
                None,
            )
            log(f"watching {interface}.{member} on {name} {path}")
        except Exception as exc:  # noqa: BLE001
            log(f"signal subscribe failed: {exc}")
            self.subscription = 0
            self.conn = None
            self.on_change = None

    def clear(self):
        if self.subscription and self.conn is not None:
            try:
                self.conn.signal_unsubscribe(self.subscription)
            except Exception:  # noqa: BLE001
                pass
        self.subscription = 0
        self.conn = None
        self.on_change = None


class AtspiChangeWatcher:
    """Notices menu edits in apps that only expose their menus via AT-SPI.

    MenuChangeWatcher covers org.gtk.Menus and dbusmenu, but Qt Quick (Devpad),
    GTK4 and Electron expose their menus only through the accessibility tree:
    things like a Recent Files repeater growing or a checkable View item
    toggling emit AT-SPI events, not D-Bus menu-model signals. Without this
    watcher the published snapshot would stay stale until focus moved away
    and back.

    Events from every app on the accessibility bus arrive here, so they are
    filtered to the focused window's pid and debounced before a refresh is
    requested. The listener's callbacks are dispatched by the GLib main
    context that run_daemon() already iterates for the D-Bus menu watcher.
    """

    DEBOUNCE = 0.2
    MAX_WAIT = 1.0

    EVENTS = (
        "object:children-changed:add",
        "object:children-changed:remove",
        "object:property-change:accessible-name",
        "object:state-changed:sensitive",
        "object:state-changed:enabled",
        "object:state-changed:checked",
        "object:state-changed:visible",
        "object:state-changed:expanded",
    )

    def __init__(self):
        self.listener = None
        self.pid = 0
        self.due_at = 0.0
        self.first_at = 0.0

    @staticmethod
    def _source_pid(acc, depth=0):
        """Process id of the app an event source belongs to."""
        if acc is None or depth > 6:
            return 0
        try:
            pid = acc.get_process_id()
            if pid:
                return int(pid)
        except Exception:  # noqa: BLE001
            pass
        try:
            parent = acc.get_parent()
        except Exception:  # noqa: BLE001
            return 0
        return AtspiChangeWatcher._source_pid(parent, depth + 1)

    def _on_event(self, event, user_data=None):
        if _HARVESTING or not self.pid:
            return
        try:
            pid = self._source_pid(event.source)
        except Exception:  # noqa: BLE001
            return
        if pid != self.pid:
            return
        now = time.monotonic()
        if not self.first_at:
            self.first_at = now
        self.due_at = now + self.DEBOUNCE
        log(f"atspi menu change: {getattr(event, 'type', '?')}")

    def start(self):
        if self.listener is not None:
            return
        try:
            Atspi = _atspi_import()
            Atspi.get_desktop(0)  # establish the a11y connection first
            listener = Atspi.EventListener.new(self._on_event, None)
            for event_type in self.EVENTS:
                if not listener.register(event_type):
                    log(f"atspi: could not register {event_type}")
            self.listener = listener
            log("watching AT-SPI menu-change events")
        except Exception as exc:  # noqa: BLE001
            log(f"atspi change watcher unavailable: {exc}")
            self.listener = None

    def poll(self, now):
        if not self.due_at:
            return False
        if now < self.due_at and now - self.first_at < self.MAX_WAIT:
            return False
        self.clear()
        return True

    def clear(self):
        self.due_at = 0.0
        self.first_at = 0.0


def run_once():
    snapshot = SnapshotBuilder(active_window()).build()
    write_snapshot(snapshot)
    log(f"wrote snapshot for '{snapshot['appName']}' (source={snapshot['source']})")


def run_daemon():
    global DEBUG, REGISTRAR  # noqa: F811
    # Own com.canonical.AppMenu.Registrar before the first snapshot, so apps
    # that need a listener register as they start and LibreOffice hides its
    # own menubar from the outset. Losing to another registrar is fine.
    registrar = AppMenuRegistrar()
    if registrar.start():
        REGISTRAR = registrar
    else:
        log("registrar unavailable; continuing without it")
    initial_window = active_window()
    snapshot = SnapshotBuilder(initial_window).build()
    write_snapshot(snapshot)
    last_signature = snapshot_signature(snapshot)
    item_map = load_item_map(snapshot)
    watcher = MenuChangeWatcher()
    watcher.watch(snapshot, lambda: refresh_on_menu_change())
    atspi_watcher = AtspiChangeWatcher()
    atspi_watcher.pid = initial_window.get("pid") or 0
    last_window_key = (initial_window.get("address"), initial_window.get("pid"), initial_window.get("class"))

    sock = connect_events()
    buffer = ""
    last_request_mtime = 0.0
    refresh_pending = False
    refresh_forced = False

    # Make apps publish their accessible menus. Without an AT-SPI event
    # listener registered, at-spi2-core >= 2.62 reports accessibility as
    # disabled, Qt apps keep their AT-SPI bridge off and export an empty
    # tree, and menu extraction falls back to the synthetic desktop menu.
    enable_atspi()
    force_a11y_enabled()
    atspi_watcher.start()
    last_a11y_check = time.monotonic()
    last_poll = time.monotonic()

    def refresh_for(window, force=False):
        nonlocal snapshot, item_map, refresh_pending, refresh_forced, last_signature
        refresh_pending = False
        refresh_forced = False
        atspi_watcher.pid = window.get("pid") or 0
        atspi_watcher.clear()
        if force:
            # A change signal says the app rebuilt its menu, so a cached
            # negative result from an earlier, transient miss must not keep
            # it on the fallback for another minute.
            pid = window.get("pid") or 0
            if pid:
                for source in ("org.gtk.Menus", "dbusmenu", "at-spi"):
                    clear_negative_cache(pid, source)
        # A window that comes back into focus may have rebuilt its title bar
        # (project opened, panel toggled), so its harvested menu is stale.
        _HARVEST_CACHE.pop(_harvest_cache_key(window.get("pid"), window.get("title")), None)
        candidate = SnapshotBuilder(window).build()
        signature = snapshot_signature(candidate)
        digest = hashlib.sha1(signature.encode("utf-8")).hexdigest()[:8]
        if signature == last_signature:
            log(f"menu unchanged (source={candidate.get('source')}, sig={digest}); keeping snapshot")
            return
        snapshot = candidate
        last_signature = signature
        write_snapshot(snapshot)
        item_map = load_item_map(snapshot)
        watcher.watch(snapshot, lambda: refresh_on_menu_change())
        log(f"refreshed '{snapshot['appName']}' (source={snapshot['source']}, sig={digest})")

    def request_refresh(force=False):
        nonlocal refresh_pending, refresh_forced
        if refresh_pending:
            return
        refresh_pending = True
        refresh_forced = force

    def refresh_on_menu_change():
        request_refresh(force=True)

    while True:
        refreshed = False

        # Keep the AT-SPI registration alive: the a11y bus (or the launcher
        # that tracks it) can be restarted under us, and IsEnabled would
        # silently drop back to false, taking every app's menus with it.
        now = time.monotonic()
        if now - last_a11y_check > 5:
            last_a11y_check = now
            if not enable_atspi(force=True):
                force_a11y_enabled()

        # Qt/GTK4/Electron menus have no D-Bus change signal: their edits show
        # up as AT-SPI events, debounced by the watcher before landing here.
        if atspi_watcher.poll(now):
            request_refresh(force=True)

        # Optional catch-all for apps that emit no usable change signal at
        # all. 0 (the default) keeps refresh purely event-driven.
        poll_interval = load_menu_config().get("pollIntervalSec") or 0.0
        if poll_interval and now - last_poll >= poll_interval:
            last_poll = now
            request_refresh(force=True)

        if refresh_pending:
            window = active_window()
            if is_shell_window(window):
                refresh_pending = False
                refresh_forced = False
            else:
                win_key = (window.get("address"), window.get("pid"), window.get("class"))
                last_window_key = win_key
                refresh_for(window, force=refresh_forced)
        if sock is None:
            sock = connect_events()
            time.sleep(1)
            continue

        try:
            ready, _, _ = select.select([sock], [], [], 0.05)
        except (OSError, ValueError):
            sock = connect_events()
            continue

        if ready:
            try:
                data = sock.recv(65536)
            except (BlockingIOError, OSError):
                data = b""
            if not data:
                sock.close()
                sock = connect_events()
                continue
            buffer += data.decode("utf-8", errors="replace")
            while "\n" in buffer:
                line, buffer = buffer.split("\n", 1)
                line = line.strip()
                if not line:
                    continue
                if line.startswith("activewindow>>"):
                    refreshed = True

        try:
            request_mtime = REQUEST_FILE.stat().st_mtime if REQUEST_FILE.exists() else 0.0
        except OSError:
            request_mtime = 0.0
        if request_mtime and request_mtime != last_request_mtime:
            last_request_mtime = request_mtime
            handle_requests(item_map)

        if refreshed:
            window = active_window()
            if is_shell_window(window):
                log(f"focus -> shell window, keeping '{snapshot['appName']}' menu")
            else:
                win_key = (window.get("address"), window.get("pid"), window.get("class"))
                if win_key == last_window_key and not refresh_pending:
                    pass
                else:
                    last_window_key = win_key
                    refresh_for(window)

        # Dispatch pending GIO/D-Bus signal callbacks (menu-change signals).
        # call_sync blocks on the main context, but signal delivery only
        # happens when we iterate it, so drain it every pass.
        Gio, GLib = _gio_import()
        for _ in range(8):
            if not GLib.MainContext.default().iteration(False):
                break


def main(argv=None):
    global DEBUG  # noqa: F811
    parser = argparse.ArgumentParser(description="Publish the focused window's menu for the omarchy bar.")
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("run", help="run the bridge daemon (default)")
    activate = sub.add_parser("activate", help="request the daemon trigger a menu item")
    activate.add_argument("item_id", nargs="?", help="menu item id from active.json (legacy)")
    activate.add_argument("--action-json", default=None, help="full action object to execute (preferred)")
    parser.add_argument("--once", action="store_true", help="write one snapshot and exit")
    parser.add_argument("--debug", action="store_true", help="verbose stderr logging")

    args = parser.parse_args(argv)
    DEBUG = args.debug
    # Defense in depth: every file this process (and its children) creates is
    # owner-only by default, so even a future code path that forgets an explicit
    # mode still lands at 0600 instead of 0644 under a 022 umask.
    os.umask(0o077)

    if args.command == "activate":
        payload = {}
        if args.action_json:
            try:
                payload["action"] = json.loads(args.action_json)
            except json.JSONDecodeError as exc:
                log(f"activate: bad action json: {exc}")
                return 1
        elif args.item_id:
            payload["id"] = args.item_id
        if not payload:
            log("activate: nothing to do")
            return 1
        ensure_private_state()
        write_private_text(REQUEST_FILE, json.dumps(payload))
        return 0

    if args.once:
        run_once()
        return 0

    run_daemon()
    return 0


if __name__ == "__main__":
    sys.exit(main())
